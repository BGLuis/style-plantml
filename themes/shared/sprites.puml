' ═══════════════════════════════════════════════════════════════
' style-plantml — Sprites (Font Awesome 5 via PlantUML stdlib)
'
' Sprites are ENABLED by default.
'
' To DISABLE sprites (plain shapes, no icons), add this line
' BEFORE your !include of any theme file:
'
'   !define HIDE_SPRITES
'
' Example:
'   !define HIDE_SPRITES
'   !include <path>/themes/light/architecture.puml
'
' The same diagram macros (SVC_COMPUTE, COL_PK, etc.) work
' identically in both modes — no diagram changes needed.
' ═══════════════════════════════════════════════════════════════

!ifndef HIDE_SPRITES

  ' ── Load tupadr3 Font Awesome 5 via PlantUML stdlib (offline, fast) ──
  !include <tupadr3/common>
  !include <tupadr3/font-awesome-5/server>
  !include <tupadr3/font-awesome-5/database>
  !include <tupadr3/font-awesome-5/exchange_alt>
  !include <tupadr3/font-awesome-5/user>
  !include <tupadr3/font-awesome-5/plug>
  !include <tupadr3/font-awesome-5/memory>
  !include <tupadr3/font-awesome-5/network_wired>
  !include <tupadr3/font-awesome-5/cloud>
  !include <tupadr3/font-awesome-5/key>
  !include <tupadr3/font-awesome-5/link>
  !include <tupadr3/font-awesome-5/search>
  !include <tupadr3/font-awesome-5/shield_alt>
  !include <tupadr3/font-awesome-5/balance_scale>

  ' ──────────────────────────────────────────────────────────────
  ' Architecture macros — WITH icons
  ' Usage: SVC_COMPUTE(alias, "Label")
  ' ──────────────────────────────────────────────────────────────
  !define SVC_COMPUTE(alias, label)       node "<$server>\nlabel" as alias <<compute>>
  !define SVC_STORAGE(alias, label)       database "<$database>\nlabel" as alias <<storage>>
  !define SVC_QUEUE(alias, label)         queue "<$exchange_alt>\nlabel" as alias <<queue>>
  !define SVC_ACTOR(alias, label)         actor "<$user>\nlabel" as alias <<actor>>
  !define SVC_EXTERNAL(alias, label)      node "<$plug>\nlabel" as alias <<external>>
  !define SVC_CACHE(alias, label)         database "<$memory>\nlabel" as alias <<cache>>
  !define SVC_LOADBALANCER(alias, label)  node "<$balance_scale>\nlabel" as alias <<loadbalancer>>
  !define SVC_CLOUD(alias, label)         cloud "<$cloud>\nlabel" as alias <<cloud>>
  !define SVC_AUTH(alias, label)          node "<$shield_alt>\nlabel" as alias <<auth>>
  !define SVC_API(alias, label)           node "<$network_wired>\nlabel" as alias <<api>>

  ' ──────────────────────────────────────────────────────────────
  ' Database / ER macros — WITH icons
  ' Usage: COL_PK(id, uuid)
  ' ──────────────────────────────────────────────────────────────
  !define COL_PK(name, type)   <color:$DB_PK><$key{scale=0.5}> <b>name</b></color> : <color:$DB_TEXT2>type</color>
  !define COL_FK(name, type)   <color:$DB_FK><$link{scale=0.5}> name</color> : <color:$DB_TEXT2>type</color>
  !define COL_IDX(name, type)  <color:$DB_IDX><$search{scale=0.5}> name</color> : <color:$DB_TEXT2>type</color>
  !define COL(name, type)      name : <color:$DB_TEXT2>type</color>

!else

  ' ──────────────────────────────────────────────────────────────
  ' Architecture macros — WITHOUT icons (plain shapes)
  ' ──────────────────────────────────────────────────────────────
  !define SVC_COMPUTE(alias, label)       node "label" as alias <<compute>>
  !define SVC_STORAGE(alias, label)       database "label" as alias <<storage>>
  !define SVC_QUEUE(alias, label)         queue "label" as alias <<queue>>
  !define SVC_ACTOR(alias, label)         actor "label" as alias <<actor>>
  !define SVC_EXTERNAL(alias, label)      node "label" as alias <<external>>
  !define SVC_CACHE(alias, label)         database "label" as alias <<cache>>
  !define SVC_LOADBALANCER(alias, label)  node "label" as alias <<loadbalancer>>
  !define SVC_CLOUD(alias, label)         cloud "label" as alias <<cloud>>
  !define SVC_AUTH(alias, label)          node "label" as alias <<auth>>
  !define SVC_API(alias, label)           node "label" as alias <<api>>

  ' ──────────────────────────────────────────────────────────────
  ' Database / ER macros — WITHOUT icons (text badges)
  ' ──────────────────────────────────────────────────────────────
  !define COL_PK(name, type)   <b><color:$DB_PK>[PK] name</color></b> : <color:$DB_TEXT2>type</color>
  !define COL_FK(name, type)   <color:$DB_FK>[FK] name</color> : <color:$DB_TEXT2>type</color>
  !define COL_IDX(name, type)  <color:$DB_IDX>[IDX] name</color> : <color:$DB_TEXT2>type</color>
  !define COL(name, type)      name : <color:$DB_TEXT2>type</color>

!endif
